{
  "datasets": [
    {
      "name": "open_cases",
      "displayName": "Open cases",
      "query": "SELECT step AS simulated_hour,\n       risk_score,\n       transaction_id AS payment,\n       sender_account AS paying_account,\n       receiver_account AS receiving_account,\n       date_format(opened_at, 'yyyy-MM-dd HH:mm') AS case_opened_at\nFROM workspace.fraud.alert_cases\nWHERE status = 'open'\nORDER BY step DESC, risk_score DESC"
    },
    {
      "name": "open_case_count",
      "displayName": "Open case count",
      "query": "SELECT COUNT(*) AS open_cases\nFROM workspace.fraud.alert_cases\nWHERE status = 'open'"
    },
    {
      "name": "review_outcomes",
      "displayName": "Review outcomes per hour",
      "query": "SELECT step AS simulated_hour, 'Confirmed fraud' AS outcome, confirmed_fraud AS cases\nFROM workspace.fraud.alert_summary_hourly WHERE closed_cases > 0\nUNION ALL\nSELECT step, 'False alarm', false_alarms\nFROM workspace.fraud.alert_summary_hourly WHERE closed_cases > 0"
    },
    {
      "name": "model_by_hour",
      "displayName": "Percent flagged that were fraud, per hour",
      "query": "WITH per_hour AS (SELECT step,\n                         SUM(confirmed_fraud) AS caught,\n                         SUM(closed_cases) AS flagged_with_verdict,\n                         MAX(fraud_in_hour) AS fraud_in_hour,\n                         try_divide(SUM(confirmed_fraud), SUM(closed_cases)) AS share_flagged\n                  FROM workspace.fraud.model_accuracy_by_hour\n                  WHERE verdicts_ready\n                  GROUP BY step)\nSELECT step AS simulated_hour, 'Each hour' AS series,\n       ROUND(100 * share_flagged, 1) AS percent_flagged_that_were_fraud\nFROM per_hour\nUNION ALL\nSELECT step, 'Average, all hours',\n       ROUND(100 * try_divide(SUM(caught) OVER (), SUM(flagged_with_verdict) OVER ()), 1)\nFROM per_hour"
    },
    {
      "name": "fraud_caught_by_hour",
      "displayName": "Fraud caught and missed, per hour",
      "query": "WITH per_hour AS (SELECT step,\n                         SUM(confirmed_fraud) AS caught,\n                         SUM(closed_cases) AS flagged_with_verdict,\n                         MAX(fraud_in_hour) AS fraud_in_hour,\n                         try_divide(SUM(confirmed_fraud), SUM(closed_cases)) AS share_flagged\n                  FROM workspace.fraud.model_accuracy_by_hour\n                  WHERE verdicts_ready\n                  GROUP BY step)\nSELECT step AS simulated_hour, 'Caught' AS result, caught AS payments FROM per_hour\nUNION ALL\nSELECT step, 'Missed', fraud_in_hour - caught FROM per_hour"
    },
    {
      "name": "model_totals",
      "displayName": "Model results so far",
      "query": "WITH ready AS (SELECT * FROM workspace.fraud.model_accuracy_by_hour WHERE verdicts_ready),\n     hours AS (SELECT DISTINCT step, fraud_in_hour FROM ready),\n     recent AS (SELECT * FROM ready WHERE step > (SELECT MAX(step) FROM ready) - 24),\n     recent_hours AS (SELECT DISTINCT step, fraud_in_hour FROM recent),\n     totals AS (SELECT (SELECT SUM(confirmed_fraud) FROM ready) AS confirmed_fraud,\n                       (SELECT SUM(closed_cases) FROM ready) AS checked_cases,\n                       (SELECT SUM(fraud_in_hour) FROM hours) AS all_fraud,\n                       (SELECT SUM(confirmed_fraud) FROM recent) AS recent_fraud,\n                       (SELECT SUM(closed_cases) FROM recent) AS recent_checked,\n                       (SELECT SUM(fraud_in_hour) FROM recent_hours) AS recent_all_fraud,\n                       (SELECT hours_waiting FROM workspace.fraud.hours_waiting_for_verdicts) AS hours_waiting)\nSELECT confirmed_fraud, checked_cases, all_fraud, hours_waiting,\n       ROUND(try_divide(confirmed_fraud, checked_cases), 3) AS share_flagged_that_were_fraud,\n       ROUND(try_divide(confirmed_fraud, all_fraud), 3) AS share_of_fraud_caught,\n       ROUND(try_divide(recent_fraud, recent_checked), 3) AS newest_24h_share_flagged_that_were_fraud,\n       ROUND(try_divide(recent_fraud, recent_all_fraud), 3) AS newest_24h_share_of_fraud_caught\nFROM totals"
    }
  ],
  "pages": [
    {
      "name": "queue",
