{
  "datasets": [
    {
      "name": "open_cases",
      "displayName": "Open cases",
      "query": "SELECT step AS simulated_hour,\n       risk_score,\n       transaction_id AS payment,\n       sender_account AS paying_account,\n       receiver_account AS receiving_account,\n       date_format(opened_at, 'yyyy-MM-dd HH:mm') AS case_opened_at\nFROM workspace.fraud.alert_cases\nWHERE status = 'open'\nORDER BY step DESC, risk_score DESC"
    },
    {
      "name": "open_case_count",
      "displayName": "Open case count",
      "query": "SELECT COUNT(*) AS open_cases\nFROM workspace.fraud.alert_cases\nWHERE status = 'open'"
    },
    {
      "name": "review_outcomes",
      "displayName": "Review outcomes per hour",
      "query": "SELECT step AS simulated_hour, 'Confirmed fraud' AS outcome, confirmed_fraud AS cases\nFROM workspace.fraud.alert_summary_hourly WHERE closed_cases > 0\nUNION ALL\nSELECT step, 'False alarm', false_alarms\nFROM workspace.fraud.alert_summary_hourly WHERE closed_cases > 0"
    },
    {
      "name": "model_by_hour",
      "displayName": "Model results per hour",
      "query": "SELECT step AS simulated_hour,\n       array_join(sort_array(collect_set(CAST(model_version AS STRING))), ' and ') AS model_version,\n       try_divide(SUM(confirmed_fraud), SUM(closed_cases)) AS share_flagged_that_were_fraud,\n       try_divide(SUM(confirmed_fraud), MAX(fraud_in_hour)) AS share_of_fraud_caught\nFROM workspace.fraud.model_accuracy_by_hour\nWHERE verdicts_ready\nGROUP BY step"
    },
    {
      "name": "model_totals",
      "displayName": "Model results so far",
      "query": "WITH ready AS (SELECT * FROM workspace.fraud.model_accuracy_by_hour WHERE verdicts_ready),\n     hours AS (SELECT DISTINCT step, fraud_in_hour FROM ready),\n     totals AS (SELECT (SELECT SUM(confirmed_fraud) FROM ready) AS confirmed_fraud,\n                       (SELECT SUM(closed_cases) FROM ready) AS checked_cases,\n                       (SELECT SUM(fraud_in_hour) FROM hours) AS all_fraud,\n                       (SELECT hours_waiting FROM workspace.fraud.hours_waiting_for_verdicts) AS hours_waiting)\nSELECT confirmed_fraud, checked_cases, all_fraud, hours_waiting,\n       ROUND(try_divide(confirmed_fraud, checked_cases), 3) AS share_flagged_that_were_fraud,\n       ROUND(try_divide(confirmed_fraud, all_fraud), 3) AS share_of_fraud_caught\nFROM totals"
    }
  ],
  "pages": [
    {
      "name": "queue",
      "displayName": "What is waiting for review?",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "widget": {
            "name": "open_count",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "open_case_count",
                  "fields": [
                    {
                      "name": "open_cases",
                      "expression": "`open_cases`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "frame": {
                "showTitle": true,
                "title": "Open cases you can see, waiting for a verdict"
              },
              "encodings": {
                "value": {
                  "fieldName": "open_cases",
                  "displayName": "Open cases"
                }
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "open_table",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "open_cases",
                  "fields": [
                    {
                      "name": "simulated_hour",
                      "expression": "`simulated_hour`"
                    },
                    {
                      "name": "risk_score",
                      "expression": "`risk_score`"
                    },
                    {
                      "name": "payment",
                      "expression": "`payment`"
                    },
                    {
                      "name": "paying_account",
                      "expression": "`paying_account`"
                    },
                    {
                      "name": "receiving_account",
                      "expression": "`receiving_account`"
                    },
                    {
                      "name": "case_opened_at",
                      "expression": "`case_opened_at`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "table",
              "frame": {
                "showTitle": true,
                "title": "Open cases, newest hour first, most suspicious first",
                "showDescription": true,
                "description": "How to read it: Each row is one flagged payment still waiting for its verdict. Managers see 0 and an empty table here: open cases are shown to reviewers and engineers only. Anyone who may not see account names sees REDACTED."
              },
              "encodings": {
                "columns": [
                  {
                    "fieldName": "simulated_hour",
                    "displayName": "Simulated hour",
                    "format": {
                      "type": "number",
                      "decimalPlaces": {
                        "type": "exact",
                        "places": 0
                      }
                    }
                  },
                  {
                    "fieldName": "risk_score",
                    "displayName": "Risk score",
                    "format": {
                      "type": "number",
                      "decimalPlaces": {
                        "type": "exact",
                        "places": 1
                      }
                    }
                  },
                  {
                    "fieldName": "payment",
                    "displayName": "Payment"
                  },
                  {
                    "fieldName": "paying_account",
                    "displayName": "Paying account"
                  },
                  {
                    "fieldName": "receiving_account",
                    "displayName": "Receiving account"
                  },
                  {
                    "fieldName": "case_opened_at",
                    "displayName": "Case opened at (UTC)"
                  }
                ]
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 6,
            "height": 8
          }
        }
      ]
    },
    {
