{
  "datasets": [
    {
      "name": "job_runs",
      "displayName": "Job runs",
      "query": "SELECT DISTINCT job_name, run_started_at, minutes_taken, coalesce(initcap(replace(outcome, '_', ' ')), 'Still running') AS outcome\nFROM workspace.fraud.job_run_times\nORDER BY run_started_at DESC"
    },
    {
      "name": "task_times",
      "displayName": "Task minutes",
      "query": "SELECT run_started_at, task_name, task_minutes, coalesce(initcap(replace(task_outcome, '_', ' ')), 'Still running') AS task_outcome\nFROM workspace.fraud.job_run_times\nWHERE job_name = 'fraud-ingest' AND task_name IS NOT NULL"
    },
    {
      "name": "pipeline_updates",
      "displayName": "Pipeline updates",
      "query": "SELECT update_started_at, minutes_taken, coalesce(initcap(replace(outcome, '_', ' ')), 'Still running') AS outcome,\n       CASE WHEN full_rebuild THEN 'Full rebuild' ELSE 'New rows only' END AS update_kind\nFROM workspace.fraud.pipeline_update_times\nORDER BY update_started_at DESC"
    },
    {
      "name": "freshness",
      "displayName": "Newest hour at each stage",
      "query": "SELECT '1. Copied to the landing folder' AS stage, newest_hour_released AS newest_simulated_hour FROM workspace.fraud.data_freshness\nUNION ALL SELECT '2. Loaded', newest_hour_ingested FROM workspace.fraud.data_freshness\nUNION ALL SELECT '3. Scored by the model', newest_hour_scored FROM workspace.fraud.data_freshness\nUNION ALL SELECT '4. Flagged for review', newest_hour_flagged FROM workspace.fraud.data_freshness"
    },
    {
      "name": "wait",
      "displayName": "Wait from landing to scored",
      "query": "SELECT median_minutes_landing_to_scored AS typical_minutes,\n       slowest_minutes_landing_to_scored AS longest_minutes\nFROM workspace.fraud.data_freshness"
    },
    {
      "name": "rejections",
      "displayName": "Rows set aside",
      "query": "SELECT CASE reason WHEN 'missing_id' THEN 'Payment ID missing' WHEN 'missing_time' THEN 'Payment time missing' WHEN 'time_step_mismatch' THEN 'Payment time does not match its simulated hour' WHEN 'bad_amount' THEN 'Amount missing or below zero' WHEN 'unknown_type' THEN 'Unknown payment type' WHEN 'missing_account' THEN 'Account name missing' WHEN 'bad_label' THEN 'Fraud answer is not 0 or 1' WHEN 'unparsed_value' THEN 'A value could not be read' WHEN 'conflicting_duplicate' THEN 'Two different records with the same payment ID'\n            ELSE reason END AS reason,\n       rows_rejected, first_hour, last_hour\nFROM workspace.fraud.rejected_rows_by_reason\nORDER BY rows_rejected DESC"
    }
  ],
