# ── Template only: copy to .env (gitignored) and fill in locally ──
# Every value below is a placeholder. Never commit real values: this repo is public.

# ── Databricks ────────────────────────────────────────────────────
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com   # workspace URL
DATABRICKS_TOKEN=<personal-access-token>                        # PAT created by the user, never by Claude

# ── Unity Catalog ─────────────────────────────────────────────────
UC_CATALOG=<catalog-name>                                       # target catalog for all tables
UC_SCHEMA=<schema-name>                                         # target schema for all tables
UC_CHECKPOINT_VOLUME=/Volumes/<catalog>/<schema>/<volume>       # streaming checkpoints (DBFS root is deprecated, see G-03)

# ── Confluent Cloud ───────────────────────────────────────────────
CONFLUENT_BOOTSTRAP_SERVERS=<pkc-xxxxx.region.provider.confluent.cloud:9092>  # cluster bootstrap endpoint
CONFLUENT_API_KEY=<api-key>                                     # cluster API key created by the user
CONFLUENT_API_SECRET=<api-secret>                               # cluster API secret created by the user
CONFLUENT_TOPIC=<topic-name>                                    # transactions topic
