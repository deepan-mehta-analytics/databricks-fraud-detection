# ── Agent workflow files (local-only, never tracked) ──────────
/CLAUDE.md
/workflow_status.md
/workflow_status_archive.md
/MEMORY.md
/feedback_*.md
/reference_*.md
/docs/superpowers/

# ── Secrets and credentials ───────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Local data (large / regenerable datasets) ─────────────────
/data/*
!/data/.gitkeep
!/data/README.md

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
.pytest_cache/

# ── Databricks / IDE ──────────────────────────────────────────
.databricks/
.vscode/
.idea/
